{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|(?:.*[._])?exec_command|shell_command|Edit|Write|apply_patch|mcp__.*(?:publish|release|deploy).*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/oso-codex.cjs\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
